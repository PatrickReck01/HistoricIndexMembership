# Copy this file to .env and fill in your own details.
#
# The SEC requires every automated request to EDGAR to say who is making it:
# a name (or company) and a contact email. Requests without one are rejected.
# See https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="Your Name your.email@example.com"

# Optional: where EDGAR responses are cached (default: ./cache).
# INDEX_MEMBERSHIP_CACHE_DIR=cache
